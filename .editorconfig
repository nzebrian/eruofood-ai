# EditorConfig — consistent coding styles across editors and IDEs
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PHP follows PSR-12 (4 spaces)
[*.php]
indent_size = 4

# JS/TS/JSON/YAML use 2 spaces
[*.{js,jsx,ts,tsx,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.dart]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
