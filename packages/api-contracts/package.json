{
  "name": "@eruofood/api-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "EruoFood AI \u2014 OpenAPI contract and generated client types (source of truth).",
  "type": "module",
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "generate:ts": "openapi-typescript openapi.yaml -o generated/ts/schema.d.ts",
    "preview": "redocly build-docs openapi.yaml -o generated/docs.html"
  },
  "devDependencies": {
    "@redocly/cli": "^2.51.2",
    "openapi-typescript": "^7.4.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
