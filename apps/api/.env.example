# =============================================================================
# EruoFood AI — API (Laravel) environment. Copy to .env and run `php artisan
# key:generate`. NEVER commit the real .env. Secrets come from a secrets
# manager in staging/production (MASTER_PLAN.md §7.3).
# =============================================================================

APP_NAME="EruoFood AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_VERSION=0.1.0
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Lagos

# ---- Logging ----
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eruofood
DB_USERNAME=eruofood
DB_PASSWORD=change_me_in_local_only
# Read replica endpoint (optional; falls back to primary if unset)
DB_READ_HOST=

# ---- Redis (cache / queue / session / pub-sub) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ---- Object storage (S3-compatible; MinIO locally) ----
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=eruofood
AWS_SECRET_ACCESS_KEY=change_me_in_local_only
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=eruofood-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Mail (Mailpit locally) ----
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@eruofood.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Real-time (Laravel Reverb / WebSockets) — reserved for later phases ----
BROADCAST_CONNECTION=null
