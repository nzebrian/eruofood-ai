# =============================================================================
# EruoFood AI — API (Laravel) environment. Copy to .env and run `php artisan
# key:generate`. NEVER commit the real .env. Secrets come from a secrets
# manager in staging/production (MASTER_PLAN.md §7.3).
# =============================================================================

APP_NAME="EruoFood AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_VERSION=0.1.0
APP_URL=http://localhost:8080
APP_TIMEZONE=Africa/Lagos
# Public web client URL — used to build email verification / reset links.
FRONTEND_URL=http://localhost:5173

# ---- Logging ----
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eruofood
DB_USERNAME=eruofood
DB_PASSWORD=change_me_in_local_only
# Read replica endpoint (optional; falls back to primary if unset)
DB_READ_HOST=

# ---- Redis (cache / queue / session / pub-sub) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ---- Object storage (S3-compatible; MinIO locally) ----
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=eruofood
AWS_SECRET_ACCESS_KEY=change_me_in_local_only
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=eruofood-media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Mail (Mailpit locally) ----
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@eruofood.ai"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Real-time (Laravel Reverb / WebSockets) — reserved for later phases ----
BROADCAST_CONNECTION=null

# ---- Identity & Access (Milestone 2) ----
# JWT access tokens (defaults to APP_KEY if unset). Use a dedicated secret in prod.
# HS256 requires a key of at least 32 bytes (php-jwt v7 enforces this); APP_KEY qualifies.
JWT_SECRET=
JWT_ALGO=HS256
JWT_ISSUER=eruofood.ai
JWT_AUDIENCE=eruofood.ai
JWT_TTL=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_EMAIL_VERIFY_TTL=1440
AUTH_PASSWORD_RESET_TTL=60
TWO_FACTOR_ISSUER="EruoFood AI"

# Social sign-in (Google enabled; Apple & phone architecture-ready but off).
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID=
PHONE_AUTH_ENABLED=false

# ---- AI Engine ----
# Selects the default provider; its API key is REQUIRED for AI features to work
# (no in-code default for a secret). Uncomment the key for whichever provider
# AI_PROVIDER selects.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ---- Back-office access (RBAC) ----
# The nine back-office roles are granted per account in `admin_accounts`. The
# coarse Identity `admin` role does NOT confer back-office authority: leaving
# this false is what keeps finance, impersonation and RBAC management separate.
# Set it true only as a temporary bridge while real admin accounts are granted.
ADMIN_IDENTITY_ADMIN_IS_SUPER=false
# Comma-separated user ids always treated as super administrators. Populate this
# on a fresh deployment so the first operator can grant the real accounts.
ADMIN_SUPER_ADMINS=

# ---- Financial integrity (M23) ----
# Retries for a use case aborted by a deadlock/serialisation failure. Those are
# transient — the transaction rolled back cleanly — so replaying is safe.
DB_TRANSACTION_ATTEMPTS=3
# How long a completed Idempotency-Key keeps replaying its stored response, and
# how long an abandoned claim blocks a retry, in seconds.
IDEMPOTENCY_TTL=86400

# ---- Module tuning (all optional — safe defaults live in config/*.php) ----
# Every other module exposes env() knobs (e.g. LOYALTY_POINTS_EXPIRY_DAYS,
# REVIEWS_MODERATION, SUPPORT_SLA_*, SEARCH_*, PAYMENTS_*). They are documented
# with their defaults in each module's config/<module>.php and need not be set
# for the app to boot. See docs/TECHNICAL_DEBT.md for the full list.

# ==============================================================================
# KYC / KYB verification (M24)
# ==============================================================================
#
# Most of these are COMMENTED OUT on purpose, and that is the important part of
# this section.
#
# `config/verification.php` picks its defaults based on the environment — in
# testing it resolves to the mock provider, in production to the real one. An
# assignment here is not a default, it is an override: it wins over that logic
# everywhere, including in CI. Writing `VERIFICATION_IDENTITY_PROVIDER=mock`
# into this file would silently force the mock provider in production, and
# writing an empty value overrides a non-empty default with an empty string.
#
# So the rule for this section is: uncomment a line only when you actually mean
# to override the environment-aware default, and never copy a provider name or
# a secret into it.
#
# The full defaults, with their reasoning, are in config/verification.php.

# ---- Enforcement (the activation gate) ----
#
# Left explicit because "off" is a deliberate safety property, not an accident:
# the platform has live merchants and riders who have never been verified, and a
# gate that took effect on deploy would delist all of them at once. See
# docs/M24_KYC_KYB_REPORT.md §8 for the activation procedure.
VERIFICATION_ENFORCEMENT_ENABLED=false

# Per-population overrides, so enforcement can be phased in one group at a time.
# Leave these COMMENTED OUT to follow the master switch — an empty assignment is
# read as "false", which is not the same as "inherit".
# VERIFICATION_ENFORCE_RIDERS=true
# VERIFICATION_ENFORCE_RESTAURANTS=true
# VERIFICATION_ENFORCE_GROCERIES=true

# ---- Progressive (step-up) verification ----
#
# Off for the same reason: these triggers gate operations existing customers
# already perform.
VERIFICATION_STEP_UP_ENABLED=false
# STEP_UP_WALLET_TRANSFER_MINOR=500000
# STEP_UP_DISPUTE_THRESHOLD=3
# STEP_UP_VELOCITY_THRESHOLD=10

# ---- Provider routing ----
#
# COMMENTED OUT deliberately. The defaults already resolve to `mock` under
# testing and to the real providers otherwise; setting them here would override
# that in both directions. Uncomment in a production environment file only.
# VERIFICATION_IDENTITY_PROVIDER=didit
# VERIFICATION_BUSINESS_PROVIDER=manual
# VERIFICATION_BUSINESS_PROVIDER_NG=cac
# VERIFICATION_SUPPORTED_COUNTRIES=NG

# ---- Didit (identity provider) ----
#
# SECRETS. Never commit real values; supply them through the deployment's secret
# store. A blank webhook secret makes every callback fail closed, which is the
# safe direction — but it also means callbacks will not work until it is set.
DIDIT_ENABLED=false
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# DIDIT_BASE_URL=https://verification.didit.me
# DIDIT_CALLBACK_URL=https://api.example.com/api/v1/verification/webhooks/didit
# DIDIT_TIMEOUT=15
# DIDIT_RETRY_ATTEMPTS=2
# DIDIT_RETRY_DELAY_MS=250
# How far a callback's timestamp may drift before it is treated as a replay.
# DIDIT_REPLAY_TOLERANCE=300
#
# Workflow ids from the Didit console — which checks each subject runs.
DIDIT_WORKFLOW_CUSTOMER_IDENTITY=
DIDIT_WORKFLOW_RIDER_IDENTITY=
DIDIT_WORKFLOW_RIDER_LICENCE=
DIDIT_WORKFLOW_BUSINESS=
DIDIT_WORKFLOW_REPRESENTATIVE=

# ---- CAC (Nigerian business registry) ----
#
# Optional. With no API configured the adapter routes every lookup to human
# review rather than reporting a company as verified — it never assumes valid.
CAC_API_BASE_URL=
CAC_API_KEY=
# CAC_API_TIMEOUT=10

# ---- Verification lifecycle ----
#
# Commented out: the defaults in config/verification.php are the intended
# values, and repeating them here only creates a second place to change.
# VERIFICATION_IDENTITY_VALIDITY_DAYS=730
# VERIFICATION_BUSINESS_VALIDITY_DAYS=365
# VERIFICATION_RECONCILE_AFTER_MINUTES=30
# VERIFICATION_METADATA_RETENTION_DAYS=1825
# VERIFICATION_PHONE_CODE_TTL=600
# VERIFICATION_PHONE_MAX_ATTEMPTS=5

# ---- Mock provider (non-production only) ----
#
# COMMENTED OUT, and this one matters: the mock provider signs and verifies for
# real, and treats a blank secret as "always reject". An empty assignment here
# overrides the working default and makes every mock callback fail — which is
# exactly what broke CI once already.
# VERIFICATION_MOCK_WEBHOOK_SECRET=
# VERIFICATION_MOCK_REPLAY_TOLERANCE=300

# ==============================================================================
# Notification email channel (M24 foundation)
# ==============================================================================
#
# `log` records the send and transmits nothing. It is the default and it stays
# the default here, so a local or CI environment can never email a real
# customer. Set `mailer` in a production environment file to go through
# Laravel's configured mail transport; the ESP credentials live in the MAIL_*
# variables and never in a template or in source control.
NOTIFY_EMAIL_DRIVER=log
# NOTIFY_EMAIL_FROM=no-reply@example.com
# NOTIFY_EMAIL_FROM_NAME=EruoFood
# NOTIFY_APP_NAME=EruoFood
# Where verification emails send somebody who needs more than the email says.
# Emails carry status and a link; the detail stays behind a login.
# NOTIFY_APP_URL=https://app.example.com
# NOTIFY_SUPPORT_EMAIL=support@example.com

# ==============================================================================
# Dispatch, Vehicles & Rider Assignment (M26)
# ==============================================================================
#
# The switch that matters is the last one. Everything above it is tuning; the
# engine itself ships OFF, exactly as M25's routed pricing did, because turning
# it on changes how work reaches every rider on the platform. The existing
# manual vendor assignment keeps working either way, so this is reversible with
# a configuration change — no deploy, no migration.
#
# Before switching it on, run `php artisan dispatch:vehicle-backfill-report`.
# It counts the riders who will stop receiving offers because they have no
# verified vehicle, and says why. Nobody should learn that number from the
# support queue.

# ---- Candidate discovery ----------------------------------------------------
# The search starts small and widens only as far as it must. Every extra
# candidate costs eligibility work and a routed ETA from a paid provider, so
# searching 15 km to deliver a plate of rice 500 m away is how a dispatch
# engine becomes the most expensive part of an order.
# DISPATCH_INITIAL_RADIUS=3000
# DISPATCH_MAX_RADIUS=15000
# DISPATCH_RADIUS_EXPANSION=2.0
# DISPATCH_MIN_POOL=3
# DISPATCH_MAX_POOL=25
# DISPATCH_MAX_RAW_CANDIDATES=100

# ---- Scoring ----------------------------------------------------------------
# Seven factors, each normalised to 0–1. They need not sum to 1 — the service
# renormalises — which is also what lets the ETA factor drop out during a map
# provider outage without changing what the other factors mean relative to each
# other.
# DISPATCH_WEIGHT_PROXIMITY=0.30
# DISPATCH_WEIGHT_ETA=0.25
# DISPATCH_WEIGHT_VEHICLE=0.15
# DISPATCH_WEIGHT_WORKLOAD=0.10
# DISPATCH_WEIGHT_PERFORMANCE=0.10
# DISPATCH_WEIGHT_ACCEPTANCE=0.05
# DISPATCH_WEIGHT_ZONE=0.05
# DISPATCH_NORM_DISTANCE=15000
# DISPATCH_NORM_ETA=3600
# DISPATCH_NORM_WORKLOAD=3

# ---- Fairness ---------------------------------------------------------------
# Without this, the nearest high performer takes every order in their area,
# earns more, scores higher, and takes more — starving everyone else and
# eventually burning out the person winning it.
#
# The total swing (max_penalty + idle_boost) is CLAMPED at construction to no
# more than DISPATCH_WEIGHT_PROXIMITY. If fairness could swing further than
# distance is worth it could overturn any distance gap at all, and a rider
# twelve kilometres away would beat one five hundred metres away — which an
# earlier draft of this system did. Setting these higher than the proximity
# weight scales them down; it does not honour them.
# DISPATCH_FAIRNESS_ENABLED=true
# DISPATCH_FAIRNESS_MAX_PENALTY=0.20
# DISPATCH_FAIRNESS_WINDOW=3600
# DISPATCH_FAIRNESS_PER_ASSIGNMENT=0.08
# DISPATCH_FAIRNESS_CONSECUTIVE_CAP=5
# DISPATCH_FAIRNESS_IDLE_AFTER=1800
# DISPATCH_FAIRNESS_IDLE_BOOST=0.10

# ---- Offers and reassignment ------------------------------------------------
# Long enough for a rider to notice and read the offer; short enough that a
# customer is not waiting on somebody who put their phone down.
# DISPATCH_OFFER_TTL=45
# DISPATCH_CONCURRENT_OFFERS=1
# DISPATCH_MAX_ATTEMPTS=5
# DISPATCH_MAX_DURATION=600
# DISPATCH_EXCLUDE_DECLINERS=true
# A replacement search inherits what is left of the customer's original
# deadline, not a fresh grant. Below this much remaining time no replacement is
# opened at all — one that fails in twenty seconds wastes the pool's attention
# and delays the honest answer, which is that this delivery needs a human.
# DISPATCH_MIN_REASSIGN_BUDGET=60

# ---- Eligibility ------------------------------------------------------------
# These four rules may be switched off per market. The three MANDATORY rules —
# rider identity verification, vehicle verification, document currency — are
# not here and have no variables, because a flag that switches off "is this
# rider legally allowed to drive" is a flag somebody will eventually set at 2am
# to clear a backlog. `EligibilityService` ignores any attempt to disable them.
# DISPATCH_RULE_LOCATION_FRESH=true
# DISPATCH_RULE_LOCATION_ACCURATE=true
# DISPATCH_RULE_SERVICE_AREA=true
# DISPATCH_RULE_NO_CONFLICT=true
# DISPATCH_MAX_ACCURACY_METRES=250

# ---- Vehicles ---------------------------------------------------------------
# DISPATCH_MAX_VEHICLES_PER_RIDER=3
# DISPATCH_EXPIRY_WARNING_DAYS=14

# ---- The engine switch ------------------------------------------------------
# OFF. See the note at the top of this section before changing it.
DISPATCH_ENGINE_ENABLED=false
# Manual assignment by an operator, retained as a break-glass path even when
# the engine is on, and audited every time it is used.
# DISPATCH_ALLOW_MANUAL_OVERRIDE=true
