# =============================================================================
# EruoFood AI — Web client environment. Copy to .env. Only VITE_-prefixed
# variables are exposed to the browser bundle — never put secrets here.
# =============================================================================

# Base URL of the REST API (through the Nginx edge in local dev).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# App metadata surfaced in the UI.
VITE_APP_NAME="EruoFood AI"
VITE_APP_ENV=local
