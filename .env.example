# =============================================================================
# EruoFood AI — Root environment (consumed by docker-compose)
# Copy to .env and adjust. NEVER commit the real .env.
# Per-app runtime config lives in apps/*/.env (see each app's .env.example).
# =============================================================================

# ---- Project ----
COMPOSE_PROJECT_NAME=eruofood
APP_ENV=local                       # local | staging | production
TZ=Africa/Lagos

# ---- Host port mappings (change if they clash locally) ----
NGINX_HTTP_PORT=8080
WEB_DEV_PORT=5173
API_FPM_PORT=9000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- PostgreSQL ----
POSTGRES_DB=eruofood
POSTGRES_USER=eruofood
POSTGRES_PASSWORD=change_me_in_local_only

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=eruofood
MINIO_ROOT_PASSWORD=change_me_in_local_only
MINIO_DEFAULT_BUCKET=eruofood-media

# ---- Image tags (pinned for reproducibility) ----
PHP_IMAGE_TAG=8.4-fpm-alpine
NODE_IMAGE_TAG=22-alpine
POSTGRES_IMAGE_TAG=16-alpine
REDIS_IMAGE_TAG=7-alpine
NGINX_IMAGE_TAG=1.27-alpine

# ==============================================================================
# Maps & Geolocation (M25)
# ==============================================================================
#
# Every variable here is COMMENTED OUT on purpose. An assignment in this file is
# an override, not a default — M24 learned that the hard way when a blank
# assignment silently defeated logic that read `env('X', APP_ENV === 'testing' ?
# 'mock' : 'real')` and cost twelve failing CI runs. Leaving these commented
# lets the shipped defaults do their job: `mock` under testing, `google`
# everywhere else.

# ---- Provider selection ----
#
# Google is the initial provider and is not baked in: each capability resolves
# through a registry, so pointing a market at a regional provider is this line
# plus an adapter class.
# GEO_GEOCODING_PROVIDER=google
# GEO_ROUTING_PROVIDER=google
# GEO_PLACES_PROVIDER=google

# ---- Google Maps credentials ----
#
# TWO KEYS, and the split is load-bearing.
#
# GOOGLE_MAPS_SERVER_KEY is a SERVER credential. It is usually unrestricted by
# IP and must never reach a browser or a mobile binary. It travels in the
# `X-Goog-Api-Key` header and never in a URL, because query strings end up in
# access logs, proxy logs and exception traces.
#
# GOOGLE_MAPS_CLIENT_KEY is the one that ships to clients. It is expected to
# carry HTTP-referrer / bundle-id restrictions at the Google console and to be
# limited to map display and autocomplete. Exposing it buys an attacker map
# tiles on our quota and nothing else.
#
# Neither belongs in this file or in source control. Set them per environment.
# GOOGLE_MAPS_ENABLED=true
# GOOGLE_MAPS_SERVER_KEY=
# GOOGLE_MAPS_CLIENT_KEY=
# GOOGLE_MAPS_TIMEOUT=8
# GOOGLE_MAPS_RETRY_ATTEMPTS=2
# GOOGLE_MAPS_REGION_BIAS=ng
# GOOGLE_MAPS_LANGUAGE=en

# ---- Cache lifetimes (seconds) ----
#
# The spread is deliberate. An address's coordinates do not change, so a month
# is conservative and every hit is a request not billed. A traffic-aware
# duration is the opposite: cached for hours it stops being traffic-aware and
# becomes a confidently wrong number, so it gets minutes.
# GEO_CACHE_GEOCODE_TTL=2592000
# GEO_CACHE_REVERSE_TTL=604800
# GEO_CACHE_ROUTE_TTL=86400
# GEO_CACHE_ROUTE_TRAFFIC_TTL=300
# GEO_CACHE_AUTOCOMPLETE_TTL=3600
#
# How old a cached route may be and still be charged for when the provider is
# unreachable. Beyond this the fallback chain moves on rather than billing
# against a stale answer.
# GEO_STALE_ROUTE_GRACE=21600

# ---- Cost control ----
#
# Mapping APIs bill per request, so a looping mobile client is a financial
# incident that produces no error log — the bill simply arrives at month end.
# GEO_LIMIT_GEOCODE=30
# GEO_LIMIT_ROUTE=20
# GEO_LIMIT_AUTOCOMPLETE=60
# GEO_LIMIT_RIDER_LOCATION=30
# GEO_PROVIDER_DAILY_QUOTA=50000
# GEO_CIRCUIT_FAILURES=5
# GEO_CIRCUIT_OPEN_SECONDS=60

# ---- Privacy ----
#
# Decimal places used when coordinates appear in a public listing. 3 dp is about
# 110 m: enough to place a merchant on a map, not enough to identify a doorway.
# GEO_PUBLIC_COORD_PRECISION=3
# A rider position older than this is not a position, it is history.
# GEO_RIDER_STALE_SECONDS=300

# ==============================================================================
# Delivery pricing switch (M25)
# ==============================================================================
#
# THE MOST CONSEQUENTIAL SETTING IN THIS FILE. It ships OFF and stays off here.
#
# Before M25 the per-kilometre delivery fee was computed from straight-line
# distance. Roads are neither straight nor on a sphere: in Lagos the routed
# distance commonly runs 1.3–1.6x the straight line. The old fee therefore did
# not merely wobble around the true cost — it understated it, in one direction,
# on every single order.
#
# Turning this on corrects that, which RAISES real customer prices. That is a
# business decision, not a deployment side effect.
#
# The safe sequence:
#   1. Deploy with it false (this default). Nothing changes for anybody.
#   2. Set DELIVERY_ROUTING_SHADOW_MODE=true. Routed distances are measured and
#      the difference is recorded; customers still pay the old fee.
#   3. When the spread is understood, set DELIVERY_ROUTING_PRICING_ENABLED=true.
#   4. Rollback is setting it back to false. No deploy, no migration.
#
# DELIVERY_ROUTING_PRICING_ENABLED=false
# DELIVERY_ROUTING_SHADOW_MODE=false
#
# What happens when routed pricing is on and no route can be established. True
# (the default) refuses to quote and offers pickup; false permits the merchant's
# own published flat fee instead. NEITHER setting ever permits a straight-line
# bill.
# DELIVERY_REFUSE_WHEN_ROUTING_UNAVAILABLE=true
