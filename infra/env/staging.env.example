# EruoFood AI — STAGING environment template
# Production-equivalent topology with non-production data and relaxed logging.
# Staging is the target for the performance certification (docs/PERFORMANCE_REPORT.md)
# and the external penetration test (docs/PENETRATION_TEST_PLAN.md).

APP_NAME="EruoFood AI (staging)"
APP_ENV=staging
APP_KEY=__SET__
APP_DEBUG=false
APP_VERSION=__SET__                  # commit SHA or pre-release tag
APP_URL=https://staging.api.eruofood.ai
APP_TIMEZONE=Africa/Lagos
FRONTEND_URL=https://staging.app.eruofood.ai

LOG_CHANNEL=stack
LOG_LEVEL=info
LOG_STDERR=true

DB_CONNECTION=pgsql
DB_HOST=__SET__
DB_PORT=5432
DB_DATABASE=eruofood_staging
DB_USERNAME=__SET__
DB_PASSWORD=__SET__
DB_READ_HOST=__SET__
DB_SSLMODE=require

REDIS_HOST=__SET__
REDIS_PORT=6379
REDIS_PASSWORD=__SET__
REDIS_SCHEME=tls
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=__SET__
AWS_SECRET_ACCESS_KEY=__SET__
AWS_DEFAULT_REGION=__SET__
AWS_BUCKET=__SET__
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=__SET__
MAIL_PORT=587
MAIL_USERNAME=__SET__
MAIL_PASSWORD=__SET__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@staging.eruofood.ai"
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=__SET__
JWT_ALGO=HS256
JWT_ISSUER=staging.eruofood.ai
JWT_AUDIENCE=staging.eruofood.ai
JWT_TTL=15
AUTH_REFRESH_TTL_DAYS=30

GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=__SET__
GOOGLE_CLIENT_SECRET=__SET__
APPLE_AUTH_ENABLED=false

PUBLICAPI_ENFORCE_HTTPS=true
PUBLICAPI_WEBHOOK_TIMEOUT=5

# Load-test API key for the k6 performance suite (staging only).
PERF_API_KEY=__SET__
