# EruoFood AI — PRODUCTION environment template
# Copy to your secrets manager (NOT into git). Every `__SET__` value must come
# from the secret store (AWS Secrets Manager / GCP Secret Manager / Vault),
# injected at deploy time. Never commit real secrets. See docs/BACKUP_RESTORE.md
# and docs/PRODUCTION_DEPLOYMENT.md.

APP_NAME="EruoFood AI"
APP_ENV=production
APP_KEY=__SET__                      # php artisan key:generate --show (stored in secret manager)
APP_DEBUG=false                      # MUST be false in production
APP_VERSION=__SET__                  # release tag, e.g. v1.0.0 (set by CI on deploy)
APP_URL=https://api.eruofood.ai
APP_TIMEZONE=Africa/Lagos
FRONTEND_URL=https://app.eruofood.ai

LOG_CHANNEL=stack
LOG_LEVEL=warning                    # info/warning in prod, never debug
LOG_STDERR=true                      # containers log to stdout/stderr for the platform collector

# --- PostgreSQL (managed; primary + optional read replica) ---
DB_CONNECTION=pgsql
DB_HOST=__SET__                      # managed primary endpoint
DB_PORT=5432
DB_DATABASE=eruofood
DB_USERNAME=__SET__
DB_PASSWORD=__SET__
DB_READ_HOST=__SET__                 # read-replica endpoint (empty = use primary)
DB_SSLMODE=require                   # TLS to the database is mandatory

# --- Redis (managed; TLS + auth) ---
REDIS_HOST=__SET__
REDIS_PORT=6379
REDIS_PASSWORD=__SET__
REDIS_SCHEME=tls
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# --- Object storage (S3 or compatible) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=__SET__            # prefer IAM role/IRSA over static keys
AWS_SECRET_ACCESS_KEY=__SET__
AWS_DEFAULT_REGION=__SET__
AWS_BUCKET=__SET__
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail (transactional provider) ---
MAIL_MAILER=smtp
MAIL_HOST=__SET__
MAIL_PORT=587
MAIL_USERNAME=__SET__
MAIL_PASSWORD=__SET__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@eruofood.ai"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth / JWT ---
JWT_SECRET=__SET__                   # 256-bit random; rotate per docs/INCIDENT_RESPONSE.md
JWT_ALGO=HS256
JWT_ISSUER=eruofood.ai
JWT_AUDIENCE=eruofood.ai
JWT_TTL=15
AUTH_REFRESH_TTL_DAYS=30

# --- OAuth providers ---
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=__SET__
GOOGLE_CLIENT_SECRET=__SET__
APPLE_AUTH_ENABLED=true
APPLE_CLIENT_ID=__SET__

# --- Public API / webhooks ---
PUBLICAPI_ENFORCE_HTTPS=true         # webhook egress: HTTPS only (see docs/INFRA_EGRESS_POLICY.md)
PUBLICAPI_WEBHOOK_TIMEOUT=5

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=__SET__  # traces/metrics collector
SENTRY_DSN=__SET__                   # error tracking (optional)

# --- Broadcasting (if realtime enabled) ---
BROADCAST_CONNECTION=redis
